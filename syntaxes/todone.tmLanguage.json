{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "This file is generated by scripts/build-grammar.js. Edit that script instead.",
    "Ported from ToDone for Sublime Text by tiffon (https://github.com/tiffon/sublime-to-done), MIT License."
  ],
  "name": "ToDone",
  "scopeName": "text.todone",
  "fileTypes": [
    "todo",
    "todone"
  ],
  "patterns": [
    {
      "include": "#block-content"
    }
  ],
  "repository": {
    "block-content": {
      "patterns": [
        {
          "include": "#completed-task"
        },
        {
          "include": "#cancelled-task"
        },
        {
          "include": "#heading"
        },
        {
          "include": "#emergency-task-5"
        },
        {
          "include": "#emergency-task-4"
        },
        {
          "include": "#emergency-task-3"
        },
        {
          "include": "#emergency-task-2"
        },
        {
          "include": "#emergency-task-1"
        },
        {
          "include": "#task-5"
        },
        {
          "include": "#task-4"
        },
        {
          "include": "#task-3"
        },
        {
          "include": "#task-2"
        },
        {
          "include": "#task-1"
        },
        {
          "include": "#note"
        }
      ]
    },
    "heading": {
      "patterns": [
        {
          "name": "markup.heading meta.heading.block.todone",
          "begin": "^(/\\*)",
          "beginCaptures": {
            "1": {
              "name": "comment punctuation.definition.heading.begin.todone"
            }
          },
          "end": "(\\*/)",
          "endCaptures": {
            "1": {
              "name": "comment punctuation.definition.heading.end.todone"
            }
          }
        },
        {
          "name": "markup.heading meta.heading.todone",
          "match": "^[^\\s.\\-+!].*$"
        }
      ]
    },
    "completed-task": {
      "name": "comment meta.task.completed.todone",
      "begin": "^([ \\t]*)(\\+)(!?)(?:(-[1-5]|-+)(?=\\s))?([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "markup.inserted meta.state.completed.todone"
        },
        "3": {
          "name": "meta.state.emergency.inherited.todone"
        },
        "4": {
          "name": "meta.marker.completed.todone"
        },
        "6": {
          "name": "markup.strikethrough meta.title.completed.todone"
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#finished-content"
        }
      ]
    },
    "cancelled-task": {
      "name": "comment meta.task.cancelled.todone",
      "begin": "^([ \\t]*)(\\.)(\\+?)(!?)(-[1-5]|-+)(?=\\s)([ \\t]*)(?:(\\()([^)\\n]*)(\\)))?([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "markup.deleted meta.state.cancelled.todone"
        },
        "3": {
          "name": "meta.state.completed.inherited.todone"
        },
        "4": {
          "name": "meta.state.emergency.inherited.todone"
        },
        "5": {
          "name": "meta.marker.cancelled.todone"
        },
        "7": {
          "name": "emphasis markup.deleted punctuation.definition.reason.begin.todone"
        },
        "8": {
          "name": "emphasis markup.deleted meta.reason.cancelled.todone"
        },
        "9": {
          "name": "emphasis markup.deleted punctuation.definition.reason.end.todone"
        },
        "11": {
          "name": "meta.title.cancelled.todone"
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#finished-content"
        }
      ]
    },
    "finished-content": {
      "patterns": [
        {
          "match": "^[ \\t]+([.+]*!?(?:-[1-5]|-+))(?=\\s)",
          "captures": {
            "1": {
              "name": "meta.marker.inherited.todone"
            }
          }
        },
        {
          "include": "#raw-note"
        }
      ]
    },
    "emergency-task-5": {
      "name": "meta.task.emergency.priority-5.todone",
      "begin": "^([ \\t]*)(!)(-{5}|-(5))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "invalid.illegal strong meta.state.emergency.todone"
        },
        "3": {
          "name": "invalid.illegal strong meta.marker.priority-5.todone"
        },
        "4": {
          "name": "meta.marker.numeral.todone"
        },
        "6": {
          "name": "invalid.illegal strong meta.title.priority-5.emergency.todone",
          "patterns": [
            {
              "include": "#emphasis"
            }
          ]
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#block-content"
        }
      ]
    },
    "emergency-task-4": {
      "name": "meta.task.emergency.priority-4.todone",
      "begin": "^([ \\t]*)(!)(-{4}|-(4))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "invalid.illegal strong meta.state.emergency.todone"
        },
        "3": {
          "name": "punctuation.definition.list.begin.markdown meta.marker.priority-4.todone"
        },
        "4": {
          "name": "meta.marker.numeral.todone"
        },
        "6": {
          "name": "entity.name.function strong meta.title.priority-4.emergency.todone",
          "patterns": [
            {
              "include": "#emphasis"
            }
          ]
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#block-content"
        }
      ]
    },
    "emergency-task-3": {
      "name": "meta.task.emergency.priority-3.todone",
      "begin": "^([ \\t]*)(!)(-{3}|-(3))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "invalid.illegal strong meta.state.emergency.todone"
        },
        "3": {
          "name": "punctuation.definition.list.begin.markdown meta.marker.priority-3.todone"
        },
        "4": {
          "name": "meta.marker.numeral.todone"
        },
        "6": {
          "name": "keyword.control strong meta.title.priority-3.emergency.todone",
          "patterns": [
            {
              "include": "#emphasis"
            }
          ]
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#block-content"
        }
      ]
    },
    "emergency-task-2": {
      "name": "meta.task.emergency.priority-2.todone",
      "begin": "^([ \\t]*)(!)(-{2}|-(2))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "invalid.illegal strong meta.state.emergency.todone"
        },
        "3": {
          "name": "punctuation.definition.list.begin.markdown meta.marker.priority-2.todone"
        },
        "4": {
          "name": "meta.marker.numeral.todone"
        },
        "6": {
          "name": "support.type strong meta.title.priority-2.emergency.todone",
          "patterns": [
            {
              "include": "#emphasis"
            }
          ]
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#block-content"
        }
      ]
    },
    "emergency-task-1": {
      "name": "meta.task.emergency.priority-1.todone",
      "begin": "^([ \\t]*)(!)(-{1}|-(1))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "invalid.illegal strong meta.state.emergency.todone"
        },
        "3": {
          "name": "punctuation.definition.list.begin.markdown meta.marker.priority-1.todone"
