    "task-1": {
      "name": "meta.task.priority-1.todone",
      "begin": "^([ \\t]*)(-{1}|-(1))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
