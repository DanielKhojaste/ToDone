    },
    "task-5": {
      "name": "meta.task.priority-5.todone",
      "begin": "^([ \\t]*)(-{5}|-(5))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "invalid.illegal strong meta.marker.priority-5.todone"
        },
        "3": {
          "name": "meta.marker.numeral.todone"
        },
        "5": {
          "name": "invalid.illegal strong meta.title.priority-5.todone",
          "patterns": [
            {
              "include": "#emphasis"
            }
          ]
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#block-content"
        }
      ]
    },
    "task-4": {
      "name": "meta.task.priority-4.todone",
      "begin": "^([ \\t]*)(-{4}|-(4))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown meta.marker.priority-4.todone"
        },
        "3": {
          "name": "meta.marker.numeral.todone"
        },
        "5": {
          "name": "entity.name.function meta.title.priority-4.todone",
          "patterns": [
            {
              "include": "#emphasis"
            }
          ]
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#block-content"
        }
      ]
    },
    "task-3": {
      "name": "meta.task.priority-3.todone",
      "begin": "^([ \\t]*)(-{3}|-(3))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown meta.marker.priority-3.todone"
        },
        "3": {
          "name": "meta.marker.numeral.todone"
        },
        "5": {
          "name": "keyword.control meta.title.priority-3.todone",
          "patterns": [
            {
              "include": "#emphasis"
            }
          ]
        }
      },
      "end": "^(?=[ \\t]*\\S)(?!\\1[ \\t])",
      "patterns": [
        {
          "include": "#block-content"
        }
