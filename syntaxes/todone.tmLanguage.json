    },
    "note": {
      "name": "comment meta.note.todone",
      "begin": "(?=\\S)",
      "end": "$",
      "patterns": [
        {
          "include": "#emphasis"
        },
        {
          "include": "#raw-note"
        }
      ]
    },
    "emphasis": {
      "name": "emphasis markup.inline.raw meta.emphasis.todone",
      "begin": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.emphasis.begin.todone"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.emphasis.end.todone"
        }
      },
      "patterns": [
        {
          "match": "\\\\`"
        }
      ]
    },
    "raw-note": {
      "name": "comment meta.note.raw.todone",
      "begin": "///",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.raw.begin.todone"
        }
      },
      "end": "///",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.raw.end.todone"
        }
      },
      "patterns": [
        {
          "include": "#emphasis"
        }
