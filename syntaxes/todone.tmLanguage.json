    },
    "task-2": {
      "name": "meta.task.priority-2.todone",
      "begin": "^([ \\t]*)(-{2}|-(2))(?=\\s)([ \\t]*)((?:://|/(?!//)|[^:\\n/])*)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown meta.marker.priority-2.todone"
        },
        "3": {
          "name": "meta.marker.numeral.todone"
        },
        "5": {
          "name": "support.type meta.title.priority-2.todone",
