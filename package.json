{
  "name": "todone-vscode",
  "displayName": "ToDone for VS Code",
  "description": "Unofficial VS Code port of the ToDone plain-text to-do list syntax for Sublime Text.",
  "version": "0.1.0",
  "publisher": "danielkhojaste",
  "author": {
    "name": "Daniel Khojaste"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "todo",
    "todone",
    "tasks",
    "to-do list",
    "plain text",
    "sublime"
  ],
  "activationEvents": [
    "onLanguage:todone"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "todone",
        "aliases": [
          "ToDone",
          "todone"
        ],
        "extensions": [
          ".todo",
          ".todone"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "todone",
        "scopeName": "text.todone",
        "path": "./syntaxes/todone.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "grammar": "node scripts/build-grammar.js",
    "grammar:check": "node scripts/build-grammar.js --check"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.75.0",
    "typescript": "^5.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
