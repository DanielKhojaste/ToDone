{
  "name": "todone-vscode",
  "displayName": "ToDone for VS Code",
  "description": "Unofficial VS Code port of the ToDone plain-text to-do list syntax for Sublime Text.",
  "version": "0.2.0",
  "publisher": "danielkhojaste",
  "author": {
    "name": "Daniel Khojaste"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielKhojaste/ToDone.git"
  },
  "bugs": {
    "url": "https://github.com/DanielKhojaste/ToDone/issues"
  },
  "homepage": "https://github.com/DanielKhojaste/ToDone#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "todo",
    "todone",
    "tasks",
    "to-do list",
    "plain text",
    "sublime"
  ],
  "activationEvents": [
    "onLanguage:todone"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "todone",
        "aliases": [
          "ToDone",
          "todone"
        ],
        "extensions": [
          ".todo",
          ".todone"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "todone",
        "scopeName": "text.todone",
        "path": "./syntaxes/todone.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "todone.toggleCompleted",
        "title": "Toggle Completed",
        "category": "ToDone"
      },
      {
        "command": "todone.toggleEmergency",
        "title": "Toggle Emergency",
        "category": "ToDone"
      },
      {
        "command": "todone.toggleCancelled",
        "title": "Toggle Cancelled",
        "category": "ToDone"
      },
      {
        "command": "todone.increasePriority",
        "title": "Increase Priority",
        "category": "ToDone"
      },
      {
        "command": "todone.decreasePriority",
        "title": "Decrease Priority",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority1",
        "title": "Set Priority 1",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority2",
        "title": "Set Priority 2",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority3",
        "title": "Set Priority 3",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority4",
        "title": "Set Priority 4",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority5",
        "title": "Set Priority 5",
        "category": "ToDone"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "todone.toggleCompleted",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.toggleEmergency",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.toggleCancelled",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.increasePriority",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.decreasePriority",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority1",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority2",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority3",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority4",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority5",
          "when": "editorLangId == todone"
        }
      ]
    },
    "keybindings": [
      {
        "command": "todone.toggleCompleted",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && editorLangId == todone"
      }
    ],
    "configuration": {
      "title": "ToDone",
      "properties": {
        "todone.colors": {
          "type": "string",
          "enum": [
            "builtin",
            "theme"
          ],
          "default": "builtin",
          "enumDescriptions": [
            "Color tasks with ToDone's own colors, which stay distinct in any color theme. Adjust them with workbench.colorCustomizations.",
            "Leave all coloring to the active color theme, using the scopes from the ToDone grammar."
          ],
          "markdownDescription": "Where task colors come from. `builtin` uses ToDone's own colors (customizable under `workbench.colorCustomizations`, for example `todone.priority5Foreground`). `theme` relies only on your color theme.",
          "scope": "resource"
        },
        "todone.priorityStyle": {
          "type": "string",
          "enum": [
            "preserve",
            "numeric",
            "hyphens"
          ],
          "default": "preserve",
          "enumDescriptions": [
            "Keep the notation each task already uses. New markers use the numeric form (-3).",
            "Always write numeric markers such as -3.",
            "Always write repeated hyphens such as ---."
          ],
          "markdownDescription": "How priority commands write the priority marker. With `preserve`, a task written as `-5` stays numeric and a task written as `-----` keeps its hyphens.",
          "scope": "resource"
        },
        "todone.outline.showCompletedTasks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show completed (`+`) tasks and their subtasks in the Outline view and in Go to Symbol.",
          "scope": "resource"
        },
        "todone.outline.showCancelledTasks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show cancelled (`.`) tasks and their subtasks in the Outline view and in Go to Symbol.",
          "scope": "resource"
        }
      }
    },
    "colors": [
      {
        "id": "todone.markerForeground",
        "description": "Marker of a priority 1 task.",
        "defaults": {
          "dark": "#8A8A8A",
          "light": "#8A8A8A",
          "highContrast": "#BBBBBB",
          "highContrastLight": "#555555"
        }
      },
      {
        "id": "todone.priority1Foreground",
        "description": "Priority 1 task titles.",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "todone.priority2Foreground",
        "description": "Priority 2 task titles and markers.",
        "defaults": {
          "dark": "#8BD17C",
          "light": "#2E8B3D",
          "highContrast": "#9FE39A",
          "highContrastLight": "#1B6B2A"
        }
      },
      {
        "id": "todone.priority3Foreground",
        "description": "Priority 3 task titles and markers.",
        "defaults": {
          "dark": "#C792EA",
          "light": "#8E3FC4",
          "highContrast": "#D7AEFF",
          "highContrastLight": "#6A1FA0"
        }
      },
      {
        "id": "todone.priority4Foreground",
        "description": "Priority 4 task titles and markers.",
        "defaults": {
          "dark": "#FFCB45",
          "light": "#A86F00",
          "highContrast": "#FFD966",
          "highContrastLight": "#7A5200"
        }
      },
      {
        "id": "todone.priority5Foreground",
        "description": "Priority 5 task titles and markers.",
        "defaults": {
          "dark": "#FF5C7A",
          "light": "#D21F3C",
          "highContrast": "#FF7A92",
          "highContrastLight": "#B0102C"
        }
      },
      {
        "id": "todone.emergencyForeground",
        "description": "The ! of an emergency task.",
        "defaults": {
          "dark": "#FFFFFF",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "todone.emergencyBackground",
        "description": "Background behind the ! of an emergency task.",
        "defaults": {
          "dark": "#E5193C",
          "light": "#D21F3C",
          "highContrast": "#E5193C",
          "highContrastLight": "#B0102C"
        }
      },
      {
        "id": "todone.completedForeground",
        "description": "The + of a completed task.",
        "defaults": {
          "dark": "#53E442",
          "light": "#2E9E3E",
          "highContrast": "#6CFF5C",
          "highContrastLight": "#1B6B2A"
        }
      },
      {
        "id": "todone.cancelledForeground",
        "description": "The . of a cancelled task and its reason.",
        "defaults": {
          "dark": "#E08A4F",
          "light": "#B85A1E",
          "highContrast": "#FFA366",
          "highContrastLight": "#8A3F0E"
        }
      },
      {
        "id": "todone.noteForeground",
        "description": "Notes.",
        "defaults": {
          "dark": "#9A9A9A",
          "light": "#6E6E6E",
          "highContrast": "#CCCCCC",
          "highContrastLight": "#444444"
        }
      },
      {
        "id": "todone.headingForeground",
        "description": "Headings.",
        "defaults": {
          "dark": "#6CB6FF",
          "light": "#1F6FEB",
          "highContrast": "#8CC8FF",
          "highContrastLight": "#0B4FB3"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint .",
    "watch": "tsc -watch -p ./",
    "grammar": "node scripts/build-grammar.js",
    "grammar:check": "node scripts/build-grammar.js --check",
    "pretest": "npm run compile",
    "test": "npm run lint && npm run grammar:check && npm run test:unit",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\" \"out/test/grammar/**/*.test.js\"",
    "test:integration": "npm run compile && vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.5",
    "mocha": "^11.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
