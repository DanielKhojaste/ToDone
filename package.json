{
  "name": "todone-vscode",
  "displayName": "ToDone for VS Code",
  "description": "Unofficial VS Code port of the ToDone plain-text to-do list syntax for Sublime Text.",
  "version": "0.1.0",
  "publisher": "danielkhojaste",
  "author": {
    "name": "Daniel Khojaste"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielKhojaste/ToDone.git"
  },
  "bugs": {
    "url": "https://github.com/DanielKhojaste/ToDone/issues"
  },
  "homepage": "https://github.com/DanielKhojaste/ToDone#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "todo",
    "todone",
    "tasks",
    "to-do list",
    "plain text",
    "sublime"
  ],
  "activationEvents": [
    "onLanguage:todone"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "todone",
        "aliases": [
          "ToDone",
          "todone"
        ],
        "extensions": [
          ".todo",
          ".todone"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "todone",
        "scopeName": "text.todone",
        "path": "./syntaxes/todone.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "todone.toggleCompleted",
        "title": "Toggle Completed",
        "category": "ToDone"
      },
      {
        "command": "todone.toggleEmergency",
        "title": "Toggle Emergency",
        "category": "ToDone"
      },
      {
        "command": "todone.toggleCancelled",
        "title": "Toggle Cancelled",
        "category": "ToDone"
      },
      {
        "command": "todone.increasePriority",
        "title": "Increase Priority",
        "category": "ToDone"
      },
      {
        "command": "todone.decreasePriority",
        "title": "Decrease Priority",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority1",
        "title": "Set Priority 1",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority2",
        "title": "Set Priority 2",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority3",
        "title": "Set Priority 3",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority4",
        "title": "Set Priority 4",
        "category": "ToDone"
      },
      {
        "command": "todone.setPriority5",
        "title": "Set Priority 5",
        "category": "ToDone"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "todone.toggleCompleted",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.toggleEmergency",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.toggleCancelled",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.increasePriority",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.decreasePriority",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority1",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority2",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority3",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority4",
          "when": "editorLangId == todone"
        },
        {
          "command": "todone.setPriority5",
          "when": "editorLangId == todone"
        }
      ]
    },
    "keybindings": [
      {
        "command": "todone.toggleCompleted",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && editorLangId == todone"
      }
    ],
    "configuration": {
      "title": "ToDone",
      "properties": {
        "todone.priorityStyle": {
          "type": "string",
          "enum": [
            "preserve",
            "numeric",
            "hyphens"
          ],
          "default": "preserve",
          "enumDescriptions": [
            "Keep the notation each task already uses. New markers use the numeric form (-3).",
            "Always write numeric markers such as -3.",
            "Always write repeated hyphens such as ---."
          ],
          "markdownDescription": "How priority commands write the priority marker. With `preserve`, a task written as `-5` stays numeric and a task written as `-----` keeps its hyphens."
        },
        "todone.outline.showCompletedTasks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show completed (`+`) tasks and their subtasks in the Outline view and in Go to Symbol."
        },
        "todone.outline.showCancelledTasks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show cancelled (`.`) tasks and their subtasks in the Outline view and in Go to Symbol."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint .",
    "watch": "tsc -watch -p ./",
    "grammar": "node scripts/build-grammar.js",
    "grammar:check": "node scripts/build-grammar.js --check",
    "pretest": "npm run compile",
    "test": "npm run lint && npm run grammar:check && npm run test:unit",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\" \"out/test/grammar/**/*.test.js\"",
    "test:integration": "npm run compile && vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.5",
    "mocha": "^11.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
